NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/almahdi?replicaSet=rs0
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGINS=http://localhost:8081
TZ_BUSINESS=Asia/Karachi

# Optional. Number of proxies in front of the API (set 1 on Render/Railway/behind nginx).
# TRUST_PROXY=0

# Optional, used only by `npm run seed`. If unset, passwords are generated and printed once.
# SEED_PASSWORD=
